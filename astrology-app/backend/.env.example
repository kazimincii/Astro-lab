# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment: development | production | test
NODE_ENV=development

# Server port
PORT=3000

# Application name
APP_NAME=Astrology Super App

# =============================================================================
# DATABASE (PostgreSQL 15+)
# =============================================================================
# Connection details
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=astrology_db

# Alternative: Use DATABASE_URL for cloud services (Heroku, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:port/database

# Enable SQL query logging (for debugging)
TYPEORM_LOGGING=false

# =============================================================================
# REDIS (Cache & Session Store)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Alternative: Use REDIS_URL for cloud services
# REDIS_URL=redis://user:password@host:port

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret (MUST be at least 32 characters in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# JWT Refresh Token Secret (optional, defaults to JWT_SECRET if not set)
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this

# Token expiration times
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:19006,http://localhost:8081,http://localhost:3000

# Allow credentials (cookies, authorization headers)
CORS_CREDENTIALS=true

# =============================================================================
# AI SERVICES (Optional - for AI Assistant)
# =============================================================================
# OpenAI API Key (for GPT-4 AI Assistant)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic API Key (for Claude AI Assistant)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4.5
ANTHROPIC_MAX_TOKENS=2000

# Choose AI provider: 'openai' or 'anthropic'
AI_PROVIDER=anthropic

# =============================================================================
# STRIPE PAYMENT PROCESSING
# =============================================================================
# API Keys - Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Webhook Secret - Get from: https://dashboard.stripe.com/webhooks
# Required for handling payment events securely
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Product IDs (create products in Stripe Dashboard)
STRIPE_STANDARD_PRODUCT_ID=prod_standard
STRIPE_PREMIUM_PRODUCT_ID=prod_premium

# Price IDs (create prices for each product in Stripe Dashboard)
STRIPE_STANDARD_MONTHLY_PRICE_ID=price_standard_monthly
STRIPE_STANDARD_YEARLY_PRICE_ID=price_standard_yearly
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_premium_monthly
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_premium_yearly

# =============================================================================
# AWS S3 (File Storage for Coffee Reading Images)
# =============================================================================
# IAM credentials - Get from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=AKIA-your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_REGION=us-east-1
AWS_S3_BUCKET=astrology-app-uploads

# Optional: Custom endpoint for S3-compatible services (MinIO, DigitalOcean Spaces)
# AWS_ENDPOINT=https://your-endpoint.com

# =============================================================================
# APPLICATION URLs
# =============================================================================
# Frontend URL (for email links, redirects, CORS)
FRONTEND_URL=http://localhost:19006

# Admin panel URL (optional)
ADMIN_URL=http://localhost:3001

# Backend URL (for webhooks, callbacks)
BACKEND_URL=http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================
# General rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Premium action limits per day
PREMIUM_ACTION_LIMIT_BASIC=2
PREMIUM_ACTION_LIMIT_STANDARD=4
PREMIUM_ACTION_LIMIT_PREMIUM=999999

# =============================================================================
# EMAIL (Optional - for notifications & password reset)
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email sender details
EMAIL_FROM=noreply@astrology-app.com
EMAIL_FROM_NAME=Astrology App

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log level: error | warn | info | debug | verbose
LOG_LEVEL=info

# Enable structured JSON logging (recommended for production)
LOG_JSON=false

# File logging
LOG_TO_FILE=false
LOG_FILE_PATH=./logs

# Error tracking (Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_AI_ASSISTANT=true
ENABLE_TAROT=true
ENABLE_COFFEE_READING=true
ENABLE_NUMEROLOGY=true
ENABLE_COMPATIBILITY=true

# Trial settings
TRIAL_PERIOD_DAYS=7
TRIAL_PREMIUM_ACTIONS=10

# =============================================================================
# SWISS EPHEMERIS (Astronomical Calculations)
# =============================================================================
# Path to ephemeris data files (download from swisseph.org if needed)
EPHEMERIS_PATH=./ephe

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Enable debug mode
DEBUG=false

# Disable auth for testing (NEVER use in production!)
DISABLE_AUTH=false

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. NEVER commit the actual .env file to version control!
# 2. Copy this file to .env and fill in your actual values
# 3. Use strong, unique secrets in production (min 32 characters)
# 4. Use different API keys for development, staging, and production
# 5. Consider using a secrets manager for production (AWS Secrets Manager, Vault)
# 6. All required variables are validated on startup (see src/common/config/env.validation.ts)
