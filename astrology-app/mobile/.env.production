# Production Environment Variables

# ============================================================================
# API Configuration
# ============================================================================
REACT_APP_API_BASE_URL=https://api.astrology.app/v1
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3
REACT_APP_API_RETRY_DELAY=1000

# ============================================================================
# Stripe Configuration
# ============================================================================
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_51234567890abcdefghijklmnop
REACT_APP_STRIPE_MERCHANT_ID=com.astrologyapp.superapp
REACT_APP_STRIPE_APPLE_MERCHANT_ID=merchant.com.astrologyapp

# ============================================================================
# App Configuration
# ============================================================================
REACT_APP_APP_GROUP_ID=group.com.astrologyapp.superapp
REACT_APP_VERSION=1.0.0
REACT_APP_BUILD_NUMBER=1
REACT_APP_BUNDLE_ID=com.astrologyapp.superapp

# ============================================================================
# Feature Flags
# ============================================================================
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_CRASH_REPORTING=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_PREMIUM_FEATURES=true
REACT_APP_DEBUG_MODE=false

# ============================================================================
# Anthropic AI Configuration
# ============================================================================
REACT_APP_ANTHROPIC_ENABLED=true
REACT_APP_ANTHROPIC_MODEL=claude-haiku-4.5
REACT_APP_AI_API_TIMEOUT=30000

# ============================================================================
# Analytics & Monitoring
# ============================================================================
REACT_APP_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxxx
REACT_APP_FIREBASE_PROJECT_ID=astrology-prod
REACT_APP_FIREBASE_APP_ID=1:123456789:ios:abcdefghijklmnop

# ============================================================================
# App Store Configuration
# ============================================================================
REACT_APP_ENABLE_TESTFLIGHT=false
REACT_APP_TESTFLIGHT_FEEDBACK_EMAIL=testflight@astrology.app
REACT_APP_APP_STORE_URL=https://apps.apple.com/app/astrology-super-app/id123456789

# ============================================================================
# Support & Help
# ============================================================================
REACT_APP_SUPPORT_EMAIL=support@astrology.app
REACT_APP_HELP_CENTER_URL=https://help.astrology.app
REACT_APP_PRIVACY_POLICY_URL=https://astrology.app/privacy-policy
REACT_APP_TERMS_OF_SERVICE_URL=https://astrology.app/terms-of-service

# ============================================================================
# Device Capabilities
# ============================================================================
REACT_APP_ENABLE_WIDGETS=true
REACT_APP_ENABLE_WATCH_APP=true
REACT_APP_ENABLE_SIRI_SHORTCUTS=true
REACT_APP_ENABLE_APPLE_PAY=true
REACT_APP_ENABLE_BIOMETRIC_AUTH=true

# ============================================================================
# Push Notifications
# ============================================================================
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true
REACT_APP_DAILY_NOTIFICATION_TIME=08:00
REACT_APP_NOTIFICATION_TIME_ZONE=UTC

# ============================================================================
# Trial & Subscription
# ============================================================================
REACT_APP_FREE_TRIAL_DAYS=7
REACT_APP_BASIC_PLAN_PRICE=2.99
REACT_APP_PREMIUM_PLAN_PRICE=9.99
REACT_APP_ANNUAL_PLAN_PRICE=79.99
REACT_APP_CURRENCY_CODE=USD

# ============================================================================
# App Review Notes
# ============================================================================
# This app provides astrological insights, daily horoscopes, and birth chart analysis.
# It uses Stripe for in-app purchases and Anthropic Claude AI for personalized insights.
# All user data is encrypted and GDPR/CCPA compliant.
# Free 7-day trial available, then $9.99/month or $79.99/year.
