{
  "name": "astrology-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "detox:build": "detox build-framework-cache && detox build-app-cache",
    "detox:build:ios": "detox build-framework-cache && detox build-app-cache --configuration ios.sim.release",
    "detox:test": "detox test e2e --configuration ios.sim.release --cleanup",
    "detox:test:watch": "detox test e2e --configuration ios.sim.release --cleanup --record-logs all",
    "detox:test:single": "detox test e2e/auth.e2e.test.ts --configuration ios.sim.release",
    "detox:report": "detox test-summary"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@stripe/stripe-react-native": "^0.37.2",
    "@tanstack/react-query": "^5.17.9",
    "axios": "^1.6.5",
    "date-fns": "^3.0.6",
    "expo": "~50.0.0",
    "expo-font": "~11.10.0",
    "expo-image-picker": "~14.7.1",
    "expo-linear-gradient": "~12.7.0",
    "expo-status-bar": "~1.11.1",
    "nativewind": "^4.0.1",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "tailwindcss": "^3.4.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.13",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.1.3"
  },
  "private": true
}
