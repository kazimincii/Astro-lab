# =============================================================================
# EXPO & REACT NATIVE CONFIGURATION
# =============================================================================
# Expo public runtime version (used for OTA updates)
EXPO_PUBLIC_RUNTIME_VERSION=1.0.0

# Environment: development | staging | production
EXPO_PUBLIC_ENV=development

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL
# Development (Metro bundler on physical device): use your computer's local IP
# Development (iOS Simulator): http://localhost:3000
# Development (Android Emulator): http://10.0.2.2:3000
# Production: https://api.your-domain.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# API Version
EXPO_PUBLIC_API_VERSION=v1

# API Timeout (milliseconds)
EXPO_PUBLIC_API_TIMEOUT=30000

# =============================================================================
# STRIPE PAYMENT (Mobile SDK)
# =============================================================================
# Stripe Publishable Key - Get from: https://dashboard.stripe.com/apikeys
# Use test key for development (pk_test_...)
# Use live key for production (pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Stripe Merchant Identifier (for Apple Pay)
# EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.your-app

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================
# Google Analytics Measurement ID
# EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Amplitude API Key (for user analytics)
# EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
EXPO_PUBLIC_ENABLE_AI_ASSISTANT=true
EXPO_PUBLIC_ENABLE_TAROT=true
EXPO_PUBLIC_ENABLE_COFFEE_READING=true
EXPO_PUBLIC_ENABLE_NUMEROLOGY=true
EXPO_PUBLIC_ENABLE_COMPATIBILITY=true
EXPO_PUBLIC_ENABLE_WIDGETS=true

# Enable debug mode (shows extra logging)
EXPO_PUBLIC_DEBUG=false

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# App name (displayed in UI)
EXPO_PUBLIC_APP_NAME=Astrology Super App

# App scheme for deep linking
EXPO_PUBLIC_APP_SCHEME=astrology

# Widget update interval (minutes)
EXPO_PUBLIC_WIDGET_UPDATE_INTERVAL=30

# Minimum widget update interval (minutes)
EXPO_PUBLIC_WIDGET_MIN_UPDATE_INTERVAL=5

# =============================================================================
# SOCIAL & SHARING (Optional)
# =============================================================================
# Facebook App ID (for social login/sharing)
# EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Google OAuth Client ID (for Google Sign-In)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# App Store URLs (for sharing/rating)
# EXPO_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# EXPO_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.yourapp

# =============================================================================
# PUSH NOTIFICATIONS (Optional)
# =============================================================================
# Expo Push Notification Token
# EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true

# OneSignal App ID (alternative push notification service)
# EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

# =============================================================================
# STORAGE & CACHING
# =============================================================================
# Enable offline mode
EXPO_PUBLIC_ENABLE_OFFLINE=false

# Cache duration (hours)
EXPO_PUBLIC_CACHE_DURATION=24

# Maximum cache size (MB)
EXPO_PUBLIC_MAX_CACHE_SIZE=50

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Show dev menu on shake
EXPO_PUBLIC_DEV_MENU_ENABLED=true

# Enable React Native Debugger
EXPO_PUBLIC_ENABLE_DEBUGGER=true

# Show performance metrics
EXPO_PUBLIC_SHOW_PERF_METRICS=false

# Network request logging
EXPO_PUBLIC_LOG_API_REQUESTS=false

# =============================================================================
# SUBSCRIPTION & PAYMENTS
# =============================================================================
# Trial period (days)
EXPO_PUBLIC_TRIAL_PERIOD_DAYS=7

# Free trial premium actions
EXPO_PUBLIC_TRIAL_PREMIUM_ACTIONS=10

# Subscription plan prices (for display only, actual prices come from Stripe)
EXPO_PUBLIC_STANDARD_MONTHLY_PRICE=$9.99
EXPO_PUBLIC_STANDARD_YEARLY_PRICE=$99.99
EXPO_PUBLIC_PREMIUM_MONTHLY_PRICE=$19.99
EXPO_PUBLIC_PREMIUM_YEARLY_PRICE=$199.99

# =============================================================================
# LOCALIZATION (Optional)
# =============================================================================
# Default language
EXPO_PUBLIC_DEFAULT_LANGUAGE=en

# Available languages (comma-separated)
# EXPO_PUBLIC_AVAILABLE_LANGUAGES=en,tr,es,fr,de

# =============================================================================
# IMPORTANT NOTES FOR EXPO ENVIRONMENT VARIABLES
# =============================================================================
# 1. ALL Expo environment variables MUST start with EXPO_PUBLIC_ to be accessible in the app
# 2. These variables are embedded at build time and visible in the client
# 3. NEVER put sensitive secrets here (API keys, passwords, etc.)
# 4. For sensitive data, use backend API calls with proper authentication
# 5. After changing .env, restart Metro bundler: npx expo start --clear
# 6. Variables are NOT hot-reloaded, you must restart the dev server
# 7. Copy this file to .env and fill in your actual values
# 8. Add .env to .gitignore (it should already be there)
#
# DEVICE-SPECIFIC API URLs:
# - iOS Simulator: http://localhost:3000
# - Android Emulator: http://10.0.2.2:3000  (10.0.2.2 is the host machine)
# - Physical Device: http://YOUR_COMPUTER_IP:3000 (e.g., http://192.168.1.100:3000)
#   Find your IP: 
#   - macOS/Linux: ifconfig | grep inet
#   - Windows: ipconfig
# - Production: https://api.your-domain.com
